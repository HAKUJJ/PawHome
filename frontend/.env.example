# คัดลอกเป็น frontend/.env (ห้ามใส่ key ของ Supabase ฝั่งหน้าเว็บ)
# ลิงก์ Backend รวม /api
VITE_API_URL=http://localhost:3000/api
# true = ใช้ข้อมูลจำลองในเบราว์เซอร์ ไม่ต้องมี Backend
VITE_USE_MOCK=false
# true = เปิด Admin Preview (ข้อมูลจำลอง) เฉพาะ npm run dev เท่านั้น ไม่มีใน production build
VITE_ADMIN_PREVIEW=false
