# ============================================================
# PawHome — root .gitignore (ใช้กับ frontend/, backend/, database/, docs/)
# เก็บเฉพาะ Source Code + ไฟล์ที่จำเป็นต่อการติดตั้ง/Build/ทดสอบ/Deploy
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases
.npm/

# ---------- Build output / Generated artifacts ----------
dist/
build/
out/
.next/
.vite/
.vercel/
.turbo/
*.tsbuildinfo
# Prisma Client ที่ generate ออกมา (สร้างใหม่ด้วย `prisma generate` ตอน postinstall)
backend/src/generated/
generated/prisma/

# ---------- Environment / Secrets ----------
# .env ทุกโฟลเดอร์ (.env, .env.local, .env.production, ...) — อนุญาตเฉพาะ .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials.json
service-account*.json
*.secret
secrets/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Tests / Coverage ----------
coverage/
*.lcov
.nyc_output/
playwright-report/
blob-report/
test-results/
playwright/.cache/
.vitest-cache/

# ---------- Local Supabase state ----------
supabase/.branches/
supabase/.temp/
supabase/.env
.supabase/

# ---------- Local database files ----------
*.sqlite
*.sqlite3
*.db
pgdata/
*.dump

# ---------- Local uploads ----------
uploads/
backend/uploads/
frontend/public/uploads/

# ---------- Temporary files ----------
tmp/
temp/
.tmp/
.cache/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# ---------- OS files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.sublime-workspace
.history/

# ---------- Claude Code (ค่าเฉพาะเครื่อง) ----------
.claude/settings.local.json

# ---------- MCP (ค่าเฉพาะเครื่อง: project_ref) — คัดลอกจาก .mcp.example.json ----------
.mcp.json
