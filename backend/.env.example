# คัดลอกเป็น backend/.env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
PORT=3000
# โดเมนหน้าเว็บ คั่นหลายโดเมนด้วย ,
CORS_ORIGIN=http://localhost:5173
# หน้าเว็บที่ลิงก์ยืนยันอีเมลพากลับมา (ค่าเริ่มต้น = โดเมนแรกของ CORS_ORIGIN)
APP_URL=http://localhost:5173

# 🔒 Supabase → Connect → Session pooler (แทน [YOUR-PASSWORD] ด้วยรหัสฐานข้อมูล)
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API (Project URL อย่างเดียว ไม่มี /rest/v1)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# 🔒 ข้าม RLS ได้ — ใช้ฝั่ง Backend เท่านั้น
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

STORAGE_BUCKET=pet-images

# false = ไม่เชื่อ X-Forwarded-For · อยู่หลัง proxy ให้ใส่จำนวน proxy เช่น 1
TRUST_PROXY=false

# จำกัดครั้งต่อ IP ต่อนาที
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
