# คัดลอกเป็น backend/.env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
PORT=3000
# โดเมนหน้าเว็บ คั่นหลายโดเมนด้วย ,
CORS_ORIGIN=http://localhost:5173
# หน้าเว็บที่ลิงก์ยืนยันอีเมลพากลับมา (ค่าเริ่มต้น = โดเมนแรกของ CORS_ORIGIN)
APP_URL=http://localhost:5173

# 🔒 Supabase → Connect (แทน [YOUR-PASSWORD] ด้วยรหัสฐานข้อมูล)
#   เครื่อง dev: Session pooler (พอร์ต 5432)
#   Vercel (serverless): Transaction pooler (พอร์ต 6543) + ?pgbouncer=true&connection_limit=1
#     postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API (Project URL อย่างเดียว ไม่มี /rest/v1)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# 🔒 ข้าม RLS ได้ — ใช้ฝั่ง Backend เท่านั้น
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

STORAGE_BUCKET=pet-images

# false = ไม่เชื่อ X-Forwarded-For (เครื่อง dev) · Vercel ให้ตั้ง 1 (Vercel เขียนทับ X-Forwarded-For ด้วย IP จริงทุกครั้ง)
TRUST_PROXY=false

# จำกัดครั้งต่อ IP ต่อนาที
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# 🔒 ตัวนับ rate limit ร่วมกันทุก instance — บังคับเมื่อรันบน Vercel (เครื่อง dev เว้นว่างได้ = นับในหน่วยความจำ)
# Upstash Console → Database → REST API · หรือเชื่อม Upstash ผ่าน Vercel Marketplace (จะได้ KV_REST_API_URL / KV_REST_API_TOKEN ให้เอง)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
